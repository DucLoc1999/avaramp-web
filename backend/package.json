{
  "name": "@avarampl/backend",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "@avarampl/backend — the AvaRamp web channel backend (ex web-be): Google auth, user profile, KYC ID recognition, payment methods, SPA serving and the partner agent for orders",
  "main": "dist/server.js",
  "engines": {
    "node": ">=v22.22.3"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx node_modules/.bin/knex migrate:latest --knexfile src/knexfile.ts",
    "migrate:prod": "node node_modules/.bin/knex migrate:latest --knexfile dist/knexfile.js",
    "migrate:rollback": "tsx node_modules/.bin/knex migrate:rollback --knexfile src/knexfile.ts",
    "move-users-schema": "tsx scripts/move-users-to-web-be-schema.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "knex": "^3.1.0",
    "pg": "^8.13.0",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pino-pretty": "^13.1.3",
    "sqlite3": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
