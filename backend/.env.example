# --- @avarampl/backend (AvaRamp web channel backend, ex web-be) ---

# HTTP
PORT=3002
HOST=0.0.0.0
NODE_ENV=development
# Optional: cross-origin frontend origin. Leave empty for same-origin (default:
# the SPA is served by this backend on the same origin).
FRONTEND_ORIGIN=
LOG_LEVEL=info

# SPA static assets served by this backend (history fallback for deep links).
# Dev (running from backend/): ../frontend/dist/spa
# Container: ../dist/spa (the image puts the SPA at /app/dist/spa)
SPA_DIST_DIR=../frontend/dist/spa

# User auth (Google OAuth -> service JWT)
USER_JWT_SECRET=
USER_JWT_EXPIRES_SEC=86400
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# KYC ID recognition (hybrid OCR.space + Gemini)
ID_RECOGNITION_PROVIDER=hybrid
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OCR_SPACE_API_KEY=
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
OCR_SPACE_ENGINE=2
OCR_SPACE_TIMEOUT_MS=12000

# KYC image storage (S3)
AWS_S3_REGION=ap-southeast-1
AWS_S3_ENDPOINT=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Database (same Postgres instance as payment_svc; this backend owns the `web-be` schema)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=avaramp
DB_SCHEMA=web-be
DB_SSL=false

# payment_svc base URL. This backend proxies unmatched /api/* and /landing/* here
# and calls its partner endpoints for order create/cancel.
# Cross-server: use payment_svc's public URL (e.g. https://payment-api.example.com).
# Local dev with payment_svc published on the host: http://localhost:3001
PAYMENT_SVC_BASE_URL=http://localhost:3000
# Partner-App-Key held server-side; used when this backend acts as the web
# channel's partner agent for /api/orders/* (never exposed to the browser).
PAYMENT_SVC_PARTNER_APP_KEY=
# Optional request timeout (ms) for payment_svc calls
PAYMENT_SVC_TIMEOUT_MS=15000
