# Same-origin build: leave VITE_BASE_URL empty so every browser call is
# relative to the origin that serves the SPA (the channel backend).
VITE_BASE_URL=

# Google OAuth Client ID for Google Sign-In
VITE_GOOGLE_CLIENT_ID=

# Avalanche C-Chain id sent with buy/sell orders: 43113=Fuji(testnet), 43114=Mainnet
VITE_AVAX_CHAIN_ID="43113"

# USDT token contract address used for USDT buy/sell orders.
# Leave empty for native AVAX.
VITE_AVAX_USDT_CONTRACT=

# Optional Telegram support link
VITE_TELEGRAM_LINK=

# NOTE: No partner/payment secrets belong here. Order creation and cancellation
# are performed by the backend on the user's behalf; the partner key is held
# server-side and never ships in the browser bundle.
